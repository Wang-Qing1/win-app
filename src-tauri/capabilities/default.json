{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "winbook 默认能力集。只放开业务真正用到的插件权限，不做通配。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "opener:allow-reveal-item-in-dir"
  ]
}
