# winbook 环境配置示例
# 使用方法：复制为 .env 后按需修改。.env 已被 .gitignore 忽略，切勿提交真实密钥。
#
# 说明：主进程启动时会读取该文件并集中校验，任一项非法将直接快速失败并弹窗退出。

# 运行模式：development | production | test
NODE_ENV=development

# 日志级别：debug | info | warn | error
WINBOOK_LOG_LEVEL=debug

# 日志文件最大字节数，超出后轮转为 winbook.log.1
WINBOOK_LOG_MAX_BYTES=5242880

# SQLite 数据库文件名（实际路径为 %APPDATA%\winbook\<文件名>）
WINBOOK_DB_FILENAME=winbook.db

# 主窗口默认尺寸
WINBOOK_WINDOW_WIDTH=1280
WINBOOK_WINDOW_HEIGHT=820

# 是否启用开发者工具（仅开发模式建议开启）：true | false
WINBOOK_DEVTOOLS=false

# 是否强制关闭硬件加速（改用软件渲染）：true | false
# 虚拟机、远程桌面、无独显的服务器上，Chromium 的 GPU 进程可能反复崩溃并直接
# 带走整个应用（日志表现为 "GPU process isn't usable. Goodbye."，退出码 3）。
# 遇到启动即崩溃时，把这里改成 true 试试。
WINBOOK_DISABLE_GPU=false
